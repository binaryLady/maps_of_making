# API Keys for LifeTech Member Extraction Pipeline
# Copy this file to .env and fill in your actual API keys
# IMPORTANT: Never commit .env to version control!

# Mistral API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# FireCrawl API Configuration (optional, for fallback scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Nominatim Geocoding (optional, usually works without auth)
NOMINATIM_USER_AGENT=maps-of-making/1.0

# Output Configuration
OUTPUT_DIRECTORY=./lifetech.brussels
LOG_LEVEL=INFO
